<h3>Assembly</h3>
@page "/assembly/{id:guid}"
@inject HttpClient Http
@inject IJSRuntime JS

<link rel="stylesheet" href="css/assembly-detail.css" />

@if (selectedAssembly != null)
{
<h1>
    <span>@selectedAssembly.Name</span>&nbsp;
    <small class="text-muted">
        <span>@selectedAssembly.FullName</span>
    </small>
</h1>
<div class="row">
    <div class="col-3">
        <h2 class="namespace-title text-muted">Namespaces</h2>
        <div id="namespaces">
            <div class="list-group list-group-flush">
                @foreach (var ns in selectedAssembly.Namespaces)
                {
                    <div class="list-group-item list-group-item-action flex-column align-items-start">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1 text-truncate" title="@ns.Name">@ns.Name</h6>
                        </div>
                        <p class="mb-1">
                            <button type="button" hidden="@ns.Classes.IsNullOrEmpty()" @onclick="() => ShowClasses(ns.Name)" class="btn btn-warning" title="# of classes">@ns.Classes.Count Classes</button>
                            <button type="button" hidden="@ns.Structures.IsNullOrEmpty()" @onclick="() => ShowStructures(ns.Name)" class="btn btn-info" title="# of structures">@ns.Structures.Count Structures</button>
                            <button type="button" hidden="@ns.Interfaces.IsNullOrEmpty()" @onclick="() => ShowInterfaces(ns.Name)" class="btn btn-primary" title="# of interfaces">@ns.Interfaces.Count Interfaces</button>
                            <button type="button" hidden="@ns.Enumerations.IsNullOrEmpty()" @onclick="() => ShowEnumerations(ns.Name)" class="btn btn-secondary" title="# of enumerations">@ns.Enumerations.Count Enums</button>
                            <button type="button" hidden="@ns.Delegates.IsNullOrEmpty()" @onclick="() => ShowDelegates(ns.Name)" class="btn btn-primary" title=" # of delegates">@ns.Delegates.Count Delegates</button>
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (selectedNamespace != null)
    {
        <div class="col-9 border border-top-0 border-bottom-0 border-right-0">
            <h2 id="namespace-title" class="namespace-title">@selectedNamespace.Name</h2>
            <div class="row">
                <div class="col-3">
                    <h3>@selectedTypesTitle</h3>
                    <div id="types">
                        <div class="list-group list-group-flush" id="type-list">
                            @foreach (var type in selectedTypes)
                            {
                                <div class="list-group-item list-group-item-action flex-column align-items-start">
                                    <button type="button" @onclick="() => ShowType(type)" class="btn btn-link">
                                        <h5 class="list-group-item-heading text-truncate" title="@type.Name">@type.Name</h5>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @if (selectedType != null)
                {
                    <div class="col-9" id="type-details">
                        <div class="col-12" id="type-details-header">
                            <h3 title="@selectedType.FullName">
                                @selectedType.Name
                                <small>
                                    <span class="badge badge-primary" hidden="@(!selectedType.IsPublic)">Public</span>
                                    <span class="badge badge-secondary" hidden="@selectedType.IsPublic">Private</span>
                                    <span class="badge badge-info" hidden="@(!selectedType.IsAbstract)">Abstract</span>
                                    <span class="badge badge-warning" hidden="@(!selectedType.IsSealed)">Sealed</span>
                                </small>
                            </h3>
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">Inherited</li>
                                    @foreach (var parent in selectedType.Parents)
                                    {
                                        <li class="breadcrumb-item">@parent.Name</li>
                                    }
                                </ol>
                            </nav>
                            <p>@selectedType.Summary</p>
                            <p class="text-muted hidden">@selectedType.Remarks</p>
                            <p class="text-muted hidden">@selectedType.Example</p>
                        </div>

                        <div class="col-12" id="type-details-body">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item" hidden="@selectedType.Constructors.IsNullOrEmpty()">
                                    <a class="nav-link" href="#Constructors" aria-controls="Constructors" role="tab" data-toggle="tab">
                                        <img src="img/method.gif" class="border-0" alt="method" /> Constructors
                                    </a>
                                </li>
                                <li class="nav-item" hidden="@selectedType.Methods.IsNullOrEmpty()">
                                    <a class="nav-link" href="#Methods" aria-controls="Methods" role="tab" data-toggle="tab">
                                        <img src="img/method.gif" class="border-0" alt="method" /> Methods
                                    </a>
                                </li>
                                <li class="nav-item" hidden="@selectedType.Properties.IsNullOrEmpty()">
                                    <a class="nav-link" href="#Properties" aria-controls="Properties" role="tab" data-toggle="tab">
                                        <img src="img/property.gif" class="border-0" alt="property" /> Properties
                                    </a>
                                </li>
                                <li class="nav-item" hidden="@selectedType.Members.IsNullOrEmpty()">
                                    <a class="nav-link" href="#Members" aria-controls="Members" role="tab" data-toggle="tab">
                                        <img src="img/enumeration.gif" class="border-0" alt="members" /> Members
                                    </a>
                                </li>
                            </ul>
                            <div class="tab-content">
                                <div class="tab-pane" id="Constructors" role="tabpanel" hidden="@selectedType.Constructors.IsNullOrEmpty()">
                                    <div class="accordion">
                                        @foreach (var ctor in selectedType.Constructors)
                                        {
                                            string elementId = $"collapse-{Guid.NewGuid()}";
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="mb-0">
                                                        <button type="button" class="btn btn-link collapsed" data-toggle="collapse" data-target="#@elementId" aria-expanded="false" aria-controls="collapse-@ctor.Id">
                                                            <img src="img/method.gif" class="border-0" alt="method" /> @(ctor.Name)(@ctor.FormattedParams)
                                                        </button>
                                                    </h5>
                                                </div>
                                                <div id="@elementId" class="collapse">
                                                    <div class="card-body">
                                                        <h5 class="card-title">@ctor.FullName</h5>
                                                        <p class="card-text">@ctor.Summary</p>
                                                        <hr />
                                                        <section hidden="@ctor.Parameters.IsNullOrEmpty()">
                                                            <h6 class="text-warning">Parameters</h6>
                                                            @foreach (var parameter in ctor.Parameters)
                                                            {
                                                                <dl>
                                                                    <dt>@parameter.Name</dt>
                                                                    <dd class="small text-muted indent-1"><strong>Type:</strong> @parameter.TypeFullName</dd>
                                                                    <dd class="small text-muted indent-1"><strong>Description:</strong> @parameter.Description</dd>
                                                                </dl>
                                                            }
                                                        </section>
                                                        <section hidden="@ctor.Remarks.IsNullOrEmpty()">
                                                            <hr />
                                                            <h6>Remarks</h6>
                                                            <p>@ctor.Remarks</p>
                                                        </section>
                                                        <section hidden="@ctor.Example.IsNullOrEmpty()">
                                                            <hr />
                                                            <h6>Example</h6>
                                                            <p>@ctor.Example</p>
                                                        </section>
                                                        <section hidden="@ctor.Exceptions.IsNullOrEmpty()">
                                                            <hr />
                                                            <h6>Exceptions</h6>
                                                            <p>@ctor.Exceptions</p>
                                                        </section>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="tab-pane" id="Methods" role="tabpanel" hidden="@selectedType.Methods.IsNullOrEmpty()">
                                    <div class="accordion">
                                        @foreach (var method in selectedType.Methods)
                                        {
                                            string elementId = $"collapse-{Guid.NewGuid()}";
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="mb-0">
                                                        <button type="button" class="btn btn-link collapsed" data-toggle="collapse" data-target="#@elementId" aria-expanded="false" aria-controls="collapse-@method.Id">
                                                            <img src="img/method.gif" class="border-0" alt="method" /> @(method.Name)(@method.FormattedParams)
                                                        </button>
                                                    </h5>
                                                </div>
                                                <div id="@elementId" class="collapse">
                                                    <div class="card-body">
                                                        <h5 class="card-title">@method.FullName</h5>
                                                        <p class="card-text">@method.Summary</p>
                                                        <hr />
                                                        <section hidden="@method.Parameters.IsNullOrEmpty()">
                                                            <h6 class="text-warning">Parameters</h6>
                                                            @foreach (var parameter in method.Parameters)
                                                            {
                                                                <dl>
                                                                    <dt>@parameter.Name</dt>
                                                                    <dd class="small text-muted indent-1"><strong>Type:</strong> @parameter.TypeFullName</dd>
                                                                    <dd class="small text-muted indent-1"><strong>Description:</strong> @parameter.Description</dd>
                                                                </dl>
                                                            }
                                                        </section>
                                                        <section hidden="@string.IsNullOrEmpty(method.Returns)">
                                                            <hr />
                                                            <h6 class="text-primary">Returns</h6>
                                                            <dl>
                                                                <dt>@method.ReturnTypeFullName</dt>
                                                                <dd class="small text-muted">@method.Returns</dd>
                                                            </dl>
                                                        </section>
                                                        <section hidden="@string.IsNullOrEmpty(method.Remarks)">
                                                            <hr />
                                                            <h6>Remarks</h6>
                                                            <p>@method.Remarks</p>
                                                        </section>
                                                        <section hidden="@string.IsNullOrEmpty(method.Example)">
                                                            <hr />
                                                            <h6>Example</h6>
                                                            <pre class="prettyprint lang-cs" lang="cs"><code>@method.Example</code></pre>
                                                        </section>
                                                        <section hidden="@string.IsNullOrEmpty(method.Exceptions)">
                                                            <hr />
                                                            <h6>Exceptions</h6>
                                                            <p>@method.Exceptions</p>
                                                        </section>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="tab-pane" id="Properties" role="tabpanel" hidden="@selectedType.Properties.IsNullOrEmpty()">
                                    <div class="accordion">
                                        @foreach (var property in selectedType.Properties)
                                        {
                                            string elementId = $"collapse-{Guid.NewGuid()}";
                                            <div class="card">
                                                <div class="card-header">
                                                    <h5 class="mb-0">
                                                        <button type="button" class="btn btn-link collapsed" data-toggle="collapse" data-target="#@elementId" aria-expanded="false" aria-controls="collapse-@property.Id">
                                                            <img src="img/property.gif" class="border-0" alt="method" /> @property.Name
                                                        </button>
                                                    </h5>
                                                </div>
                                                <div id="@elementId" class="collapse">
                                                    <div class="card-body">
                                                        <h5 class="card-title">@property.FullName</h5>
                                                        <p class="card-text">@property.Summary</p>
                                                        <hr />
                                                        <section hidden="@string.IsNullOrEmpty(property.Remarks)">
                                                            <hr />
                                                            <h6>Remarks</h6>
                                                            <p>@property.Remarks</p>
                                                        </section>
                                                        <section hidden="@string.IsNullOrEmpty(property.Example)">
                                                            <hr />
                                                            <h6>Example</h6>
                                                            <p>@property.Example</p>
                                                        </section>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="tab-pane" id="Members" role="tabpanel" hidden="@selectedType.Members.IsNullOrEmpty()">
                                    <div class="list-group">
                                        @foreach (var member in selectedType.Members)
                                        {
                                            <div class="list-group-item">
                                                <h6 class="list-group-item-heading">
                                                    <img src="img/enumeration.gif" class="border-0" alt="members" /> @member.Name
                                                </h6>
                                                <div class="list-group-item-text">
                                                    <small>@member.Description</small>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AssemblyModel selectedAssembly;
    private NamespaceModel selectedNamespace;
    private string selectedTypesTitle;
    private ICollection<TypeModel> selectedTypes = new List<TypeModel>();
    private TypeModel selectedType;

    protected override async Task OnInitializedAsync()
    {
        if (Context.Assemblies.IsNullOrEmpty())
        {
            Context.Assemblies = await Http.GetFromJsonAsync<AssemblyModel[]>("js/assemblies.json") ?? new AssemblyModel[0];
        }

        selectedAssembly = Context.Assemblies.First(x => x.Id == Id);
    }

    private void ShowClasses(string namespaceName)
    {
        ChangeNamespace(namespaceName);
        selectedTypesTitle = "Classes";
        selectedTypes = selectedNamespace.Classes;
    }

    private void ShowStructures(string namespaceName)
    {
        ChangeNamespace(namespaceName);
        selectedTypesTitle = "Structures";
        selectedTypes = selectedNamespace.Structures;
    }

    private void ShowInterfaces(string namespaceName)
    {
        ChangeNamespace(namespaceName);
        selectedTypesTitle = "Interfaces";
        selectedTypes = selectedNamespace.Interfaces;
    }

    private void ShowEnumerations(string namespaceName)
    {
        ChangeNamespace(namespaceName);
        selectedTypesTitle = "Enumerations";
        selectedTypes = selectedNamespace.Enumerations;
    }

    private void ShowDelegates(string namespaceName)
    {
        ChangeNamespace(namespaceName);
        selectedTypesTitle = "Delegates";
        selectedTypes = selectedNamespace.Delegates;
    }

    private void ChangeNamespace(string namespaceName)
    {
        selectedType = null;
        selectedTypes = new List<TypeModel>();
        selectedNamespace = selectedAssembly.Namespaces.First(x => x.Name == namespaceName);
    }

    private async void ShowType(TypeModel type)
    {
        selectedType = type;
        await JS.InvokeVoidAsync("onShowType");
    }
}
