@page "/"
@inject HttpClient Http

<PageTitle>Assemblies</PageTitle>

<link href="css/index-cards.css" rel="stylesheet" />

<header class="page-header">
    <h1>Assemblies</h1>
    @if (Context.Assemblies.Count > 0)
    {
        <p class="text-muted">@Context.Assemblies.Count documented @(Context.Assemblies.Count == 1 ? "assembly" : "assemblies")</p>
    }
</header>

<div class="assembly-grid">
    @foreach (var assembly in Context.Assemblies)
    {
        string href = $"assembly/{assembly.Id}";
        <a id="@assembly.Id" class="assembly-card" href="@href">
            <h2 title="@assembly.Name">@assembly.Name</h2>
            <p title="@assembly.FullName">@assembly.FullName</p>
            <span class="assembly-card-action">View documentation</span>
        </a>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        if (Context.Assemblies.IsNullOrEmpty())
        {
            Context.Assemblies = await Http.GetFromJsonAsync<AssemblyModel[]>("js/assemblies.json");
        }
    }
}
